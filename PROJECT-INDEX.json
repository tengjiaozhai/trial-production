{
  "name": "trial-production",
  "displayName": "试产搭配表自动生成",
  "description": "天珑手机试产搭配表自动生成交互工具，支持四步向导流程、业务规则校验及Excel导出",
  "version": "0.0.0",
  "techStack": {
    "framework": "React 19",
    "language": "TypeScript",
    "buildTool": "Vite",
    "styling": "Tailwind CSS",
    "ai": "Google Gemini"
  },
  "structure": {
    "src/": {
      "main.tsx": "应用入口",
      "App.tsx": "主应用组件，包含核心业务逻辑和状态管理",
      "types.ts": "TypeScript类型定义(ProjectInfo, SKUData, FieldDefinition等)",
      "constants.ts": "常量定义(字段配置、模板阶段、校验规则)",
      "index.css": "全局样式",
      "components/": {
        "StepsIndicator.tsx": "步骤指示器组件(5步向导)",
        "Sidebar.tsx": "侧边栏组件(校验结果、统计信息)",
        "TrialProductionTable.tsx": "试产表格主组件(支持拖拽排序)",
        "HistoryModal.tsx": "历史记录弹窗(本地存储)"
      },
      "lib/": {
        "utils.ts": "通用工具函数(PCBA解析、存储规范化等)",
        "keyMaterialTemplate.ts": "关键物料选型模板解析+LLM匹配",
        "managedMaterialCore.ts": "管控物料核心器件解析+LLM匹配",
        "sampleCollectionWorkbook.ts": "样机收集表解析+LLM匹配",
        "step2CellConflicts.ts": "Step2单元格冲突检测(PCBA配置冲突)",
        "step4SampleCalc.ts": "Step4样机数量计算",
        "step4ValidationRules.ts": "Step4校验规则(颜色/存储/标识)",
        "step5TableModel.ts": "Step5表格模型",
        "supplyProjection.ts": "供应投影处理和规范化",
        "tableOperations.ts": "表格操作(复制/粘贴/插入SKU等)",
        "tableViewport.ts": "表格视口处理",
        "trialProductionWorkbook.ts": "试产工作簿Excel生成",
        "efuseFields.ts": "eFuse字段配置"
      }
    }
  },
  "businessDomain": {
    "templates": {
      "标准": ["EVB", "EVT", "DVT1", "DVT2", "PVT", "MP"],
      "传音": ["T0", "PR0", "PR1", "PR2", "PIR", "MP"],
      "中兴": ["T0", "T1", "T2", "T3", "NPI", "MP"]
    },
    "fieldGroups": ["基本信息", "常用项", "存储/PCBA", "核心器件", "常规器件", "工艺辅料", "BOM信息", "内部样机需求", "客户样机需求", "统计汇总"],
    "fieldBehaviors": ["auto", "calc", "manual", "order_no"],
    "supplyTags": ["一供", "二供", "三供"],
    "validationRules": [
      {"id": "R-COLOR-001", "title": "颜色与MBOM/PBOM一致"},
      {"id": "R-PN-001", "title": "CCL料号vs管控表"},
      {"id": "R-MEM-001", "title": "内存闪存组合"},
      {"id": "R-QTY-001", "title": "搭配数量逻辑"},
      {"id": "R-PBOM-001", "title": "PBOM包装vs包装标签"},
      {"id": "R-HOUSING-001", "title": "壳体MBOMvs常规器件"},
      {"id": "R-EBOM-STORAGE-001", "title": "EBOM描述存储一致性"}
    ]
  },
  "llmIntegration": {
    "provider": "Google Gemini",
    "capabilities": [
      "关键物料分类2字段映射",
      "核心器件名称匹配",
      "样机需求行名匹配"
    ]
  },
  "dataFlow": [
    "文件上传",
    "文件解析(PCBA/物料/样机)",
    "LLM智能匹配",
    "SKU数据生成",
    "业务规则校验",
    "Excel导出"
  ],
  "scripts": {
    "dev": "启动开发服务器(端口3000)",
    "build": "构建生产版本",
    "lint": "TypeScript类型检查",
    "test": "运行Vitest测试"
  },
  "keyFiles": [
    "src/App.tsx",
    "src/types.ts",
    "src/constants.ts",
    "src/lib/keyMaterialTemplate.ts",
    "src/lib/managedMaterialCore.ts",
    "src/lib/sampleCollectionWorkbook.ts",
    "src/lib/trialProductionWorkbook.ts"
  ],
  "indexMetadata": {
    "createdAt": "2026-06-05",
    "purpose": "为其他模型提供项目结构和功能的快速索引"
  }
}
