{
  "name": "trial-production",
  "displayName": "试产搭配表自动生成",
  "description": "天珑手机试产搭配表自动生成交互工具，支持五步向导流程、业务规则校验及Excel导出",
  "version": "0.0.0",
  "techStack": {
    "framework": "React 19",
    "language": "TypeScript 5.8",
    "buildTool": "Vite 6",
    "styling": "Tailwind CSS 4",
    "llm": "Qwen3.7-max (via Tinno API gateway)"
  },
  "structure": {
    "src/main.tsx": "应用入口",
    "src/App.tsx": "主应用组件，1384行，所有步进状态和业务逻辑",
    "src/types.ts": "TypeScript类型定义",
    "src/constants.ts": "常量配置：119个字段、3类模板、校验规则",
    "src/config/keyMaterialLLM.ts": "LLM端点配置（qwen3.7-max @ newapi.tinno.com）",
    "src/components/": {
      "StepsIndicator.tsx": "五步向导指示器",
      "Sidebar.tsx": "侧边栏（校验结果、统计、导航按钮）",
      "TrialProductionTable.tsx": "核心表格（拖拽排序、单元格编辑、冲突展示）",
      "HistoryModal.tsx": "历史记录弹窗"
    },
    "src/lib/": {
      "utils.ts": "通用工具函数",
      "keyMaterialTemplate.ts": "关键物料模板+LLM列匹配",
      "managedMaterialCore.ts": "管控物料+LLM名称匹配",
      "sampleCollectionWorkbook.ts": "样机收集表+LLM行名匹配",
      "step2CellConflicts.ts": "PCBA配置冲突检测",
      "step4SampleCalc.ts": "样机数量计算",
      "step4ValidationRules.ts": "校验规则引擎",
      "step4StorageValidationResults.ts": "存储校验结果构建",
      "step5TableModel.ts": "导出表格模型",
      "supplyProjection.ts": "供应数据投影",
      "tableOperations.ts": "表格操作（复制/粘贴/插入）",
      "tableViewport.ts": "表格视口",
      "trialProductionWorkbook.ts": "Excel工作簿生成",
      "efuseFields.ts": "eFuse字段配置"
    },
    "docs/dev-memory/": {
      "patterns.md": "编码/架构模式",
      "decisions.md": "架构决策记录",
      "active-problems.md": "已知活跃问题",
      "troubleshooting.md": "故障排查记录"
    }
  },
  "wizardSteps": [
    "填写必填项",
    "自动获取",
    "补充完善",
    "计算与校验",
    "导出预览"
  ],
  "templates": {
    "标准": ["EVB", "EVT", "DVT1", "DVT2", "PVT", "MP"],
    "传音": ["T0", "PR0", "PR1", "PR2", "PIR", "MP"],
    "中兴": ["T0", "T1", "T2", "T3", "NPI", "MP"]
  },
  "fieldBehaviors": ["auto", "calc", "manual", "order_no"],
  "supplyTags": ["一供", "二供", "三供", "四供"],
  "dataFlow": [
    "文件上传（配置表/物料表/样机收集表/关键物料模板）",
    "PCBA解析 + LLM智能匹配",
    "SKU数据生成",
    "业务规则校验",
    "Excel导出"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && inject build timestamp",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist server.js"
  },
  "indexMetadata": {
    "createdAt": "2026-06-09",
    "purpose": "为AI模型提供项目结构和功能的快速索引"
  }
}
